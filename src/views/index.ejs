<!DOCTYPE html>
<html lang="en">
<%- include("./partials/head.ejs") %>

<body class="my-2 bg-zinc-900 text-neutral-200 flex flex-col gap-10 w-[85vw] m-auto">
  <%- include("./partials/nav.ejs") %>

  <div class="flex flex-col gap-5 w-[40%]">
    <% if (blogs.length> 0) { %>
      <% blogs.forEach(blog=> { %>
        <div class="flex flex-col gap-0.5 border-l-2 pl-3">
          <h3 class="text-2xl font-serif"><%= blog.title %></h3>
          <p class="text-lg"><%= blog.snippet %></p>
        </div>
        <% }); %>
        <% } else { %>
          <p class="text-zinc-400 text-center text-2xl my-35">There are no blogs yet.</p>
        <% } %>
  </div>
  <%- include("./partials/footer.ejs") %>
</body>

</html>