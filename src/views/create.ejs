<!DOCTYPE html>
<html lang="en">
<%- include("./partials/head.ejs") %>

<body class="my-2 bg-zinc-900 text-neutral-200 flex flex-col gap-10 w-[85vw] m-auto">
  <%- include("./partials/nav.ejs") %>

  <div class="create-blog content flex justify-center mt-3">
    <form action="/blogs" method="POST" class="flex flex-col justify-evenly gap-3 w-[30em] border-indigo-500 rounded-lg p-5 bg-zinc-800">
      <label for="title" class="text-xl font-serif">Blog title</label>
      <input type="text" id="title" required class="bg-zinc-700 h-11 text-xl outline-none px-3 pb-1 border-2 border-indigo-500 rounded-lg flex" />

      <label for="snippet" class="text-xl font-serif">Blog snippet</label>
      <input type="text" id="snippet" required class="bg-zinc-700 h-11 text-xl outline-none px-3 pb-1 border-2 border-indigo-500 rounded-lg flex" />

      <label for="body" class="text-xl font-serif">Blog body</label>
      <textarea id="body" required class="bg-zinc-700 h-30 text-xl outline-none px-3 border-2 border-indigo-500 rounded-lg flex"></textarea>

      <button class="text-zinc-900 bg-indigo-500 py-1 rounded-lg font-medium">Submit</button>
    </form>
  </div>
  <%- include("./partials/footer.ejs") %>
</body>
</html>